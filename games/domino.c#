using System;
using System.Collections.Generic;
using System.Linq;

public readonly record struct DominoTile(int x, int y)
{
    public bool IsDouble => x ==
    y;

    public override string ToString()
    {
        return $"[{x}|{y}]";
    }
}

public class Players {
    public string Player_name { get; }

    public List<DominoTile> Hand
    {get;} = new List<DominoTile>();
}
